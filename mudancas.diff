@@ -0,0 +1,25 @@
+#ifndef EFEITO_POR_TEMPO_HPP
+#define EFEITO_POR_TEMPO_HPP
+
+#include <string>
+#include "Habilidade.hpp"
+
+/**
+ * @file EfeitoPorTempo.hpp
+ * @brief Estrutura de um efeito contínuo (DoT, HoT, Buff, Debuff).
+ */
+
+/**
+ * @brief Estrutura que define as propriedades de um efeito de dano contínuo (DoT).
+ * * Mantém os dados necessários para que efeitos como veneno, queimadura ou 
+ * sangramento persistam na memória do alvo por múltiplos turnos.
+ */
+struct EfeitoPorTempo {
+    TipoHabilidade tipo;       /**< DOT, HOT, SUPORTE (Buff) ou DEBUFF */
+    int valorPorTurno;         /**< Dano, Cura ou o valor do modificador de atributo */
+    int turnosRestantes;       /**< Contador de rodadas ativo */
+    std::string nomeEfeito;    /**< Ex: "Veneno", "Regeneração", "Grito de Guerra" */
+    std::string atributoAfetado; /**< [NOVO] "hp", "defesa" ou "forca" (Útil para Buffs/Debuffs) */
+};
+
+#endif // EFEITO_POR_TEMPO_HPP
diff -ruN -x .git -x build -x doc -x .DS_Store repo/include/EntradaEncerradaException.hpp repo-corrigido/include/EntradaEncerradaException.hpp
--- repo/include/EntradaEncerradaException.hpp	1969-12-31 21:00:00
+++ repo-corrigido/include/EntradaEncerradaException.hpp	2026-11-18 11:36:07
@@ -0,0 +1,30 @@
+#ifndef ENTRADA_ENCERRADA_EXCEPTION_HPP
+#define ENTRADA_ENCERRADA_EXCEPTION_HPP
+
+#include <stdexcept>
+#include <string>
+
+/**
+ * @file EntradaEncerradaException.hpp
+ * @brief Exceção para entrada do usuário encerrada (EOF).
+ */
+
+/**
+ * @class EntradaEncerradaException
+ * @brief Exceção lançada quando a entrada do usuário termina (EOF, Ctrl+D ou arquivo redirecionado acabou).
+ *
+ * Sem ela, InterfaceJogo::solicitarEscolha ficava em loop infinito pedindo uma
+ * opção que nunca chegaria. Combate não engole esta exceção: ela sobe até a main,
+ * que encerra o jogo de forma limpa.
+ */
+class EntradaEncerradaException : public std::runtime_error {
+public:
+    /**
+     * @brief Cria a exceção com a mensagem informada.
+     * @param mensagem Descrição do motivo do encerramento.
+     */
+    explicit EntradaEncerradaException(const std::string& mensagem)
+        : std::runtime_error("[Entrada] " + mensagem) {}
+};
+
+#endif // ENTRADA_ENCERRADA_EXCEPTION_HPP
