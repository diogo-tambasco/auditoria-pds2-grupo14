diff -ruN -x .git -x build -x doc -x .DS_Store repo/include/CombateInvalidoException.hpp repo-corrigido/include/CombateInvalidoException.hpp
--- repo/include/CombateInvalidoException.hpp	1969-12-31 21:00:00
+++ repo-corrigido/include/CombateInvalidoException.hpp	2026-11-18 11:38:27
@@ -0,0 +1,30 @@
+#ifndef COMBATE_INVALIDO_EXCEPTION_HPP
+#define COMBATE_INVALIDO_EXCEPTION_HPP
+
+#include <stdexcept>
+#include <string>
+
+/**
+ * @file CombateInvalidoException.hpp
+ * @brief Exceção lançada quando um combate não pode começar.
+ */
+
+/**
+ * @class CombateInvalidoException
+ * @brief Exceção lançada quando o estado dos combatentes impede o início do combate.
+ *
+ * Exemplos de situações inválidas:
+ * - Tentar iniciar um combate com um combatente já morto.
+ * - Combatente nulo passado por referência inválida.
+ */
+class CombateInvalidoException : public std::logic_error {
+public:
+    /**
+     * @brief Cria a exceção com a mensagem informada.
+     * @param mensagem Descrição do problema.
+     */
+    explicit CombateInvalidoException(const std::string& mensagem)
+        : std::logic_error("[Combate] " + mensagem) {}
+};
+
+#endif // COMBATE_INVALIDO_EXCEPTION_HPP
diff -ruN -x .git -x build -x doc -x .DS_Store repo/include/DesafianteDoBar.hpp repo-corrigido/include/DesafianteDoBar.hpp
--- repo/include/DesafianteDoBar.hpp	1969-12-31 21:00:00
+++ repo-corrigido/include/DesafianteDoBar.hpp	2026-11-18 11:37:38
@@ -0,0 +1,46 @@
+#ifndef DESAFIANTE_DO_BAR_HPP
+#define DESAFIANTE_DO_BAR_HPP
+
+#include "Inimigo.hpp"
+#include <string>
+
+/**
+ * @file DesafianteDoBar.hpp
+ * @brief Declaração do inimigo DesafianteDoBar.
+ */
+
+/**
+ * @class DesafianteDoBar
+ * @brief Cidadão comum que frequenta os fundos do bar em busca de uma válvula de escape.
+ *
+ * Inimigo introdutório do Clube de Luta. Usa apenas dano físico bruto (socos e chutes),
+ * tem baixa defesa física e nenhuma resistência mágica. Serve para o jogador aprender
+ * a gerenciar HP e testar ataques básicos.
+ *
+ * @invariant _nivel >= 1
+ * @invariant _hp >= 0 && _hp <= _hpMax
+ */
+class DesafianteDoBar : public Inimigo {
+public:
+    /**
+     * @brief Constrói um Desafiante do Bar para um determinado nível.
+     * @param nome Nome do inimigo (usa "Desafiante do Bar" se vazio).
+     * @param nivel Nível de escalonamento dos atributos (deve ser >= 1).
+     * @throws std::invalid_argument Se nivel < 1.
+     */
+    explicit DesafianteDoBar(std::string nome, int nivel);
+
+    /**
+     * @brief Executa o turno do Desafiante: sempre ataque físico direto.
+     * @param alvo Personagem que receberá o dano.
+     * @pre alvo referencia um Personagem válido.
+     */
+    void executarTurno(Personagem& alvo) override;
+    /**
+     * @brief Monta o status do inimigo para exibir no combate.
+     * @return Texto com nome, nível e HP, pronto para imprimir.
+     */
+    std::string getDeclaracaoStatus() const override;
+};
+
+#endif // DESAFIANTE_DO_BAR_HPP
